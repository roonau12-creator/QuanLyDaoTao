@{
    ViewData["Title"] = "Trang chủ";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h1 class="display-5 fw-bold">Hệ thống Quản lý Sinh viên</h1>
            <p class="lead text-muted">Quản lý khoa, lớp và thông tin sinh viên</p>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card border-primary shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="text-primary mb-3">
                        <i class="bi bi-building" style="font-size: 3rem;"></i>
                    </div>
                    <h2 class="card-title fw-bold text-primary">@ViewBag.TongKhoa</h2>
                    <p class="card-text text-muted">Khoa</p>
                </div>
                <div class="card-footer bg-transparent border-top-0 text-center">
                    <a asp-area="Admin" asp-controller="Khoa" asp-action="Index" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-success shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="text-success mb-3">
                        <i class="bi bi-door-open" style="font-size: 3rem;"></i>
                    </div>
                    <h2 class="card-title fw-bold text-success">@ViewBag.TongLop</h2>
                    <p class="card-text text-muted">Lớp</p>
                </div>
                <div class="card-footer bg-transparent border-top-0 text-center">
                    <a asp-area="Admin" asp-controller="Lop" asp-action="Index" class="btn btn-outline-success btn-sm">Xem chi tiết</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-info shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="text-info mb-3">
                        <i class="bi bi-people" style="font-size: 3rem;"></i>
                    </div>
                    <h2 class="card-title fw-bold text-info">@ViewBag.TongSinhVien</h2>
                    <p class="card-text text-muted">Sinh viên</p>
                </div>
                <div class="card-footer bg-transparent border-top-0 text-center">
                    <a asp-area="Admin" asp-controller="SinhVien" asp-action="Index" class="btn btn-outline-info btn-sm">Xem chi tiết</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Chức năng chính</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <a asp-area="Admin" asp-controller="Khoa" asp-action="Index" class="btn btn-outline-primary w-100 py-3">
                                <i class="bi bi-building me-2"></i>Quản lý Khoa
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a asp-area="Admin" asp-controller="Lop" asp-action="Index" class="btn btn-outline-success w-100 py-3">
                                <i class="bi bi-door-open me-2"></i>Quản lý Lớp
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a asp-area="Admin" asp-controller="SinhVien" asp-action="Index" class="btn btn-outline-info w-100 py-3">
                                <i class="bi bi-people me-2"></i>Quản lý Sinh viên
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
