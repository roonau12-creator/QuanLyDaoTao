@model PhongHoc

@{
    var isEdit = Model.MaPhongHoc != 0;
    ViewData["Title"] = isEdit ? "Sửa phòng học" : "Thêm phòng học";
}

<div class="card shadow border-0">

    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">@(isEdit ? "Sửa phòng học" : "Thêm phòng học")</h4>
    </div>

    <div class="card-body">

        <form asp-action="Upsert" method="post">

            <input type="hidden" asp-for="MaPhongHoc" />

            <div class="mb-3">
                <label asp-for="TenPhong" class="form-label">
                    Tên phòng
                </label>

                <input asp-for="TenPhong"
                       class="form-control" />

                <span asp-validation-for="TenPhong"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ToaNha" class="form-label">
                    Tòa nhà
                </label>

                <input asp-for="ToaNha"
                       class="form-control" />

                <span asp-validation-for="ToaNha"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SucChua" class="form-label">
                    Sức chứa
                </label>

                <input asp-for="SucChua"
                       type="number"
                       class="form-control" />

                <span asp-validation-for="SucChua"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LoaiPhong" class="form-label">
                    Loại phòng
                </label>

                <select asp-for="LoaiPhong"
                        class="form-select">

                    <option value="">-- Chọn loại phòng --</option>
                    <option value="Phòng học">Phòng học</option>
                    <option value="Phòng máy">Phòng máy</option>
                    <option value="Phòng thí nghiệm">Phòng thí nghiệm</option>
                    <option value="Hội trường">Hội trường</option>

                </select>

                <span asp-validation-for="LoaiPhong"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TrangThai" class="form-label">
                    Trạng thái
                </label>

                <select asp-for="TrangThai"
                        class="form-select">

                    <option value="true">Hoạt động</option>
                    <option value="false">Không hoạt động</option>

                </select>
            </div>

            <div class="mb-3">
                <label asp-for="MoTa" class="form-label">
                    Mô tả
                </label>

                <textarea asp-for="MoTa"
                          class="form-control"
                          rows="4"></textarea>
            </div>

            <button type="submit"
                    class="btn btn-primary">
                @(isEdit ? "Cập nhật" : "Thêm mới")
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Quay lại
            </a>

        </form>

    </div>

</div>