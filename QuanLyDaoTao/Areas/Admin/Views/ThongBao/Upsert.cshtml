@model QuanLyDaoTao.Models.ThongBao

@{
    bool isEdit = Model.MaThongBao != 0;
}

<div class="card shadow border-0">

    <div class="card-header bg-primary text-white">

        <h4 class="mb-0">
            @(isEdit ? "Sửa thông báo" : "Thêm thông báo")
        </h4>

    </div>


    <div class="card-body">

        <form asp-action="Upsert" method="post">

            <input asp-for="MaThongBao" type="hidden" />


            <div class="mb-3">

                <label asp-for="TieuDe" class="form-label">
                    Tiêu đề
                </label>

                <input asp-for="TieuDe"
                       class="form-control"
                       placeholder="Nhập tiêu đề thông báo" />

                <span asp-validation-for="TieuDe"
                      class="text-danger">
                </span>

            </div>


            <div class="mb-3">

                <label asp-for="NoiDung" class="form-label">
                    Nội dung
                </label>

                <textarea asp-for="NoiDung"
                          class="form-control"
                          rows="6"
                          placeholder="Nhập nội dung thông báo">
                </textarea>

                <span asp-validation-for="NoiDung"
                      class="text-danger">
                </span>

            </div>


            <div class="mb-3">

                <label asp-for="LoaiNoiDung" class="form-label">
                    Loại thông báo
                </label>

                <select asp-for="LoaiNoiDung"
                        class="form-select">

                    <option value="">
                        -- Chọn loại thông báo --
                    </option>

                    <option value="Đăng ký học phần">
                        Đăng ký học phần
                    </option>

                    <option value="Học phí">
                        Học phí
                    </option>

                    <option value="Lịch học">
                        Lịch học
                    </option>

                    <option value="Lịch thi">
                        Lịch thi
                    </option>

                    <option value="Điểm">
                        Điểm
                    </option>

                    <option value="Hoạt động">
                        Hoạt động
                    </option>

                    <option value="Khác">
                        Khác
                    </option>

                </select>

                <span asp-validation-for="LoaiNoiDung"
                      class="text-danger">
                </span>

            </div>


            <div class="row">

                <div class="col-md-6 mb-3">

                    <label asp-for="NgayDang" class="form-label">
                        Ngày đăng
                    </label>

                    <input asp-for="NgayDang"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="NgayDang"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-6 mb-3">

                    <label asp-for="NgayHetHan" class="form-label">
                        Ngày hết hạn
                    </label>

                    <input asp-for="NgayHetHan"
                           type="date"
                           class="form-control" />

                </div>

            </div>


            <div class="mb-3">

                <label asp-for="NguoiDang" class="form-label">
                    Người đăng
                </label>

                <input asp-for="NguoiDang"
                       class="form-control"
                       placeholder="Nhập người đăng" />

                <span asp-validation-for="NguoiDang"
                      class="text-danger">
                </span>

            </div>


            <div class="mt-3">

                <button type="submit"
                        class="btn btn-primary">

                    @(isEdit ? "Cập nhật" : "Thêm mới")

                </button>


                <a asp-action="Index"
                   class="btn btn-secondary">

                    Quay lại

                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}