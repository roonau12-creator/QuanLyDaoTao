@model IEnumerable<QuanLyDaoTao.Models.Khoa>
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Quản lý khoa";
    var khoaList = Model.ToList();
    var xsrfToken = Antiforgery.GetTokens(Context).RequestToken;
}
<link rel="stylesheet" href="~/css/khoa.css" asp-append-version="true" />

<section class="faculty-page">
    <!-- HERO -->
    <div class="faculty-hero">
        <div class="hero-bg-shapes">
            <span class="shape shape-1"></span>
            <span class="shape shape-2"></span>
            <span class="shape shape-3"></span>
        </div>
        <div class="hero-content">
            <div class="hero-text">
                <span class="hero-eyebrow">
                    <span class="eyebrow-dot"></span>
                    HỆ THỐNG QUẢN LÝ SINH VIÊN
                </span>
                <h1>Quản lý <span class="text-gradient">Khoa</span></h1>
                <p class="hero-lead">Sắp xếp và theo dõi thông tin các đơn vị đào tạo trong trường một cách hiệu quả.</p>
            </div>
            <a class="btn-hero-primary" asp-action="Upsert">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                <span>Thêm khoa mới</span>
            </a>
        </div>
    </div>

    <!-- STATS -->
    <div class="faculty-stats">
        <article class="stat-card">
            <div class="stat-icon-wrap stat-indigo">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                    <rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
                </svg>
            </div>
            <div class="stat-body">
                <span class="stat-label">Tổng số khoa</span>
                <strong class="stat-value">@khoaList.Count</strong>
            </div>
            <span class="stat-trend trend-up">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="18 15 12 9 6 15"/></svg>
                100%
            </span>
        </article>

        <article class="stat-card">
            <div class="stat-icon-wrap stat-green">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
            </div>
            <div class="stat-body">
                <span class="stat-label">Đang hoạt động</span>
                <strong class="stat-value">@khoaList.Count</strong>
            </div>
            <span class="stat-badge badge-live">
                <span class="live-dot"></span>Live
            </span>
        </article>

        <article class="stat-card">
            <div class="stat-icon-wrap stat-orange">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                </svg>
            </div>
            <div class="stat-body">
                <span class="stat-label">Cập nhật gần đây</span>
                <strong class="stat-value">Hôm nay</strong>
            </div>
            <span class="stat-time">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
                Vừa xong
            </span>
        </article>
    </div>

    <!-- MAIN PANEL -->
    <div class="faculty-panel">
        <div class="panel-toolbar">
            <div class="toolbar-left">
                <div class="toolbar-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
                    </svg>
                </div>
                <div>
                    <h2>Danh sách khoa</h2>
                    <p>@khoaList.Count khoa trong hệ thống</p>
                </div>
            </div>
            <label class="search-box">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input id="facultySearch" type="search" placeholder="Tìm theo tên khoa..." aria-label="Tìm khoa" />
                <kbd class="search-kbd">⌘K</kbd>
            </label>
        </div>

        @if (khoaList.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-illustration">
                    <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                        <polyline points="9 22 9 12 15 12 15 22"/>
                    </svg>
                </div>
                <h3>Chưa có khoa nào</h3>
                <p>Hãy thêm khoa đầu tiên để bắt đầu quản lý dữ liệu.</p>
                <a class="btn-primary-gradient" asp-action="Upsert">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Thêm khoa mới
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="faculty-table" id="tblData" data-xsrf="@xsrfToken">
                    <thead>
                        <tr>
                            <th><span class="th-inner">Mã khoa</span></th>
                            <th><span class="th-inner">Tên khoa</span></th>
                            <th><span class="th-inner">Mô tả</span></th>
                            <th class="text-end"><span class="th-inner">Thao tác</span></th>
                        </tr>
                    </thead>
                    <tbody id="facultyRows">
                    @foreach (var khoa in khoaList)
                    {
                        <tr data-name="@khoa.TenKhoa.ToLower()">
                            <td>
                                <span class="faculty-code">
                                    <span class="code-prefix">K</span>
                                    @khoa.MaKhoa.ToString("D2")
                                </span>
                            </td>
                            <td>
                                <div class="faculty-name">
                                    <span class="faculty-avatar" style="--avatar-color: @GetColor(khoa.MaKhoa)">
                                        @khoa.TenKhoa[..1].ToUpper()
                                    </span>
                                    <div class="faculty-name-text">
                                        <strong>@khoa.TenKhoa</strong>
                                        <span class="faculty-sub">Khoa @khoa.TenKhoa</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <p class="faculty-description">
                                    @(string.IsNullOrWhiteSpace(khoa.MoTa) ? "—" : khoa.MoTa)
                                </p>
                            </td>
                            <td class="text-end">
                                <div class="action-group">
                                    <a class="btn-action btn-edit" asp-action="Upsert" asp-route-id="@khoa.MaKhoa" title="Chỉnh sửa">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                        </svg>
                                        <span>Sửa</span>
                                    </a>
                                    <button class="btn-action btn-delete" type="button" data-id="@khoa.MaKhoa" data-name="@khoa.TenKhoa" title="Xóa">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                        </svg>
                                        <span>Xóa</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <p id="noSearchResult" class="search-empty d-none">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                Không tìm thấy khoa phù hợp.
            </p>
        }
    </div>
</section>

@functions {
    string GetColor(int id) {
        var colors = new[] { "#1a73e8","#10b981","#f59e0b","#ef4444","#8b5cf6","#ec4899","#06b6d4","#84cc16" };
        return colors[id % colors.Length];
    }
}

@section Scripts {
    <script src="~/js/khoa.js"></script>
}