@model IEnumerable<QuanLyDaoTao.Models.Diem>

@{
    ViewData["Title"] = "Danh sách điểm";
}

<div class="student-card">
    <div class="student-card-header d-flex justify-content-between align-items-center">
        <h4><i class="bi bi-award me-2"></i>Danh sách điểm</h4>
        <div>
            <a asp-area="Student" asp-controller="Diem" asp-action="TongKet" class="btn btn-light btn-sm me-2">
                <i class="bi bi-calculator me-1"></i>Điểm tổng kết
            </a>
            <a asp-area="Student" asp-controller="Diem" asp-action="KetQuaHocTap" class="btn btn-light btn-sm">
                <i class="bi bi-graph-up me-1"></i>Kết quả học tập
            </a>
        </div>
    </div>
    <div class="student-card-body">
        <div class="table-responsive">
            <table id="tblData" class="table table-bordered table-striped table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>Mã điểm</th>
                        <th>Môn học</th>
                        <th>Học kỳ</th>
                        <th>Chuyên cần</th>
                        <th>Nhận xét</th>
                        <th>Giữa kỳ</th>
                        <th>Cuối kỳ</th>
                        <th>Tổng kết</th>
                        <th>Kết quả</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.MaDiem</td>
                            <td>@item.DangKyHocPhan?.HocPhan?.MonHoc?.TenMonHoc</td>
                            <td>@item.DangKyHocPhan?.HocKy?.TenHocKy</td>
                            <td>@(item.DiemChuyenCan?.ToString("F2") ?? "-")</td>
                            <td>@(item.DiemNhanXet?.ToString("F2") ?? "-")</td>
                            <td>@(item.DiemGiuaKy?.ToString("F2") ?? "-")</td>
                            <td>@(item.DiemCuoiKy?.ToString("F2") ?? "-")</td>
                            <td>
                                @if (item.DiemTongKet.HasValue)
                                {
                                    <strong>@item.DiemTongKet.Value.ToString("F2")</strong>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.KetQua))
                                {
                                    var badgeClass = item.KetQua switch
                                    {
                                        "Giỏi" => "bg-success",
                                        "Khá" => "bg-primary",
                                        "Trung bình" => "bg-warning text-dark",
                                        "Yếu" => "bg-danger",
                                        "Kém" => "bg-dark",
                                        _ => "bg-secondary"
                                    };
                                    <span class="badge @badgeClass">@item.KetQua</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.MaDiem" class="btn btn-info btn-sm text-white">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#tblData").DataTable({
                language: {
                    emptyTable: "Chưa có điểm nào",
                    zeroRecords: "Không tìm thấy",
                    search: "Tìm kiếm:",
                    lengthMenu: "Hiển thị _MENU_ dòng",
                    info: "Hiển thị _START_ đến _END_ của _TOTAL_ dòng",
                    paginate: { first: "Đầu", last: "Cuối", next: "Sau", previous: "Trước" }
                }
            });
        });
    </script>
}
