@{
    ViewData["Title"] = "Tài khoản";
}

<div class="row g-4">
    <div class="col-md-6">
        <div class="student-card h-100">
            <div class="student-card-header">
                <h4><i class="bi bi-key me-2"></i>Đổi mật khẩu</h4>
            </div>
            <div class="student-card-body">
                <p class="text-muted mb-3">Thay đổi mật khẩu để bảo mật tài khoản của bạn.</p>
                <a asp-area="Student" asp-controller="TaiKhoan" asp-action="DoiMatKhau" class="btn btn-primary">
                    <i class="bi bi-key me-1"></i>Đổi mật khẩu
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="student-card h-100">
            <div class="student-card-header" style="background:linear-gradient(135deg,#dc2626,#ef4444)">
                <h4><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</h4>
            </div>
            <div class="student-card-body">
                <p class="text-muted mb-3">Đăng xuất khỏi hệ thống và quay lại trang đăng nhập.</p>
                <form asp-area="Student" asp-controller="TaiKhoan" asp-action="DangXuat" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
