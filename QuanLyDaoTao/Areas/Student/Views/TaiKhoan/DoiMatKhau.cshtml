@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="student-card" style="max-width:500px;margin:0 auto">
    <div class="student-card-header">
        <h4><i class="bi bi-key me-2"></i>Đổi mật khẩu</h4>
    </div>
    <div class="student-card-body">
        <form asp-action="DoiMatKhau" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-bold">Mật khẩu hiện tại</label>
                <input type="password" name="matKhauCu" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Mật khẩu mới</label>
                <input type="password" name="matKhauMoi" class="form-control" required minlength="6" />
                <div class="form-text">Tối thiểu 6 ký tự, bao gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Xác nhận mật khẩu mới</label>
                <input type="password" name="xacNhanMatKhau" class="form-control" required />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle me-1"></i>Xác nhận
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Quay lại
                </a>
            </div>
        </form>
    </div>
</div>
