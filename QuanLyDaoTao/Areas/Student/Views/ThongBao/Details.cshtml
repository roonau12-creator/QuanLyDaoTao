@model QuanLyDaoTao.Models.ThongBao

@{
    ViewData["Title"] = "Chi tiết thông báo";
}

<div class="student-card">
    <div class="student-card-header">
        <h4><i class="bi bi-bell me-2"></i>Chi tiết thông báo</h4>
    </div>
    <div class="student-card-body">
        <div class="mb-4">
            <h3 class="fw-bold">@Model.TieuDe</h3>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label fw-bold text-muted small">Loại thông báo</label>
                <div class="form-control bg-light">@Model.LoaiNoiDung</div>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold text-muted small">Người đăng</label>
                <div class="form-control bg-light">@Model.NguoiDang</div>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold text-muted small">Ngày đăng</label>
                <div class="form-control bg-light">@Model.NgayDang.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold text-muted small">Ngày hết hạn</label>
                <div class="form-control bg-light">@(Model.NgayHetHan.HasValue ? Model.NgayHetHan.Value.ToString("dd/MM/yyyy") : "Không có")</div>
            </div>
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold text-muted small">Nội dung thông báo</label>
            <div class="border rounded p-3 bg-light" style="min-height:200px;white-space:pre-wrap">@Model.NoiDung</div>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i>Quay lại
            </a>
        </div>
    </div>
</div>
