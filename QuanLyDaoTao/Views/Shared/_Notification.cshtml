@if(TempData["success"]!=null)
{
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" asp-append-version="true"></script>
    <script>
        toastr.success('@TempData["success"]', {timeOut: 5000})
    </script>
}
@if(TempData["error"]!=null)
{
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" asp-append-version="true"></script>
    <script>
        toastr.error('@TempData["error"]', {timeOut: 5000})
    </script>
}

