<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuanLyDaoTao</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.datatables.net/v/dt/dt-3.0.2/datatables.min.css" rel="stylesheet" asp-append-version="true">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyDaoTao.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
    <div class="container">
      <div class="d-flex align-items-center justify-content-between py-2">
        <a class="brand" asp-action="Index" asp-controller="Home" asp-area="Customer">
          <span class="brand-badge"><i class="bi bi-mortarboard-fill"></i></span>
          <span>
            <span class="brand-title d-block">QL ĐÀO TẠO</span>
            <span class="brand-sub d-block">Cổng thông tin sinh viên</span>
          </span>
        </a>

        <nav class="d-none d-md-flex align-items-center gap-4">
          <a class="nav-link active" asp-action="Index" asp-controller="Home" asp-area="Customer">Trang chủ</a>
          <a class="nav-link" href="#about">Giới thiệu</a>
          <a class="nav-link" href="#notifications">Thông báo</a>
          <a class="nav-link" href="#guides">Hướng dẫn</a>
          <a class="nav-link" href="#contact">Liên hệ</a>
          <a class="nav-link" asp-action="Index" asp-area="Admin" asp-controller="Khoa">Khoa</a>
          <a class="nav-link" asp-action="Index" asp-area="Admin" asp-controller="Lop">Lớp</a>
          <a class="nav-link" asp-action="Index" asp-area="Admin" asp-controller="SinhVien">Sinh Viên</a>
          <a class="nav-link" asp-action="Index" asp-area="Admin" asp-controller="MonHoc">Môn học</a>
          <a class="nav-link" asp-action="Index" asp-area="Admin" asp-controller="GiangVien">Giảng viên</a>
          <a class="nav-link" asp-action="Index" asp-area="Admin" asp-controller="DangKyHocPhan">Đăng ký học phần</a>
          <a class="nav-link" asp-action="DaDangKy" asp-area="Admin" asp-controller="DangKyHocPhan">Học phần đã đăng ký</a>
        </nav>

        <div class="d-none d-md-flex gap-2">
          <a class="btn btn-outline-primary px-3" asp-area="Identity" asp-controller="Account" asp-action="Login">Đăng nhập</a>
          <button class="btn btn-primary px-3">Đăng ký</button>
        </div>

        <button class="btn btn-light d-md-none" data-bs-toggle="offcanvas" data-bs-target="#mobileNav">
          <i class="bi bi-list"></i>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile nav -->
  <div class="offcanvas offcanvas-end" tabindex="-1" id="mobileNav">
    <div class="offcanvas-header">
      <h5 class="offcanvas-title">Menu</h5>
      <button class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
      <nav class="d-flex flex-column gap-3">
        <a class="nav-link active" href="#home">Trang chủ</a>
        <a class="nav-link" href="#about">Giới thiệu</a>
        <a class="nav-link" href="#notifications">Thông báo</a>
        <a class="nav-link" href="#guides">Hướng dẫn</a>
        <a class="nav-link" href="#contact">Liên hệ</a>
        <div class="d-flex gap-2 mt-2">
          <a class="btn btn-outline-primary flex-fill" asp-area="Identity" asp-controller="Account" asp-action="Login">Đăng nhập</a>
          <button class="btn btn-primary flex-fill">Đăng ký</button>
        </div>
      </nav>
    </div>
  </div>
    <div class="container">
        <main role="main" class="pb-3">
            <partial name="_Notification" />
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11" asp-append-version="true"></script>
    <script src="https://cdn.datatables.net/v/dt/dt-3.0.2/datatables.min.js" asp-append-version="true" ></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
