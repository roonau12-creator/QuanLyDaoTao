@using QuanLyDaoTao.Models
@using Microsoft.AspNetCore.Identity

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <div class="dropdown">
        <button class="btn account-btn dropdown-toggle d-flex align-items-center gap-2"
                type="button"
                data-bs-toggle="dropdown"
                aria-expanded="false">

            <div class="user-avatar">
                <i class="bi bi-person-fill"></i>
            </div>

            <div class="user-info text-start d-none d-md-block">
                <span class="user-name">
                    @UserManager.GetUserName(User)
                </span>
                <small>Tài khoản</small>
            </div>
        </button>

        <ul class="dropdown-menu dropdown-menu-end account-menu shadow">

            <li class="account-header">
                <div class="user-avatar large">
                    <i class="bi bi-person-fill"></i>
                </div>

                <div>
                    <strong>@UserManager.GetUserName(User)</strong>
                    <small>Đang đăng nhập</small>
                </div>
            </li>

            <li>
                <hr class="dropdown-divider">
            </li>

            <li>
                <a class="dropdown-item" asp-controller="Account"
                   asp-action="Profile">
                    <i class="bi bi-person me-2"></i>
                    Hồ sơ cá nhân
                </a>
            </li>

            <li>
                <a class="dropdown-item" asp-controller="Account"
                   asp-action="ChangePassword">
                    <i class="bi bi-shield-lock me-2"></i>
                    Đổi mật khẩu
                </a>
            </li>

            <li>
                <hr class="dropdown-divider">
            </li>

            <li>
                <form method="post"
                      asp-controller="Account"
                      asp-action="Logout"
                      asp-area="Identity"
                      class="m-0">

                    <button type="submit"
                            class="dropdown-item logout-item">
                        <i class="bi bi-box-arrow-right me-2"></i>
                        Đăng xuất
                    </button>
                </form>
            </li>

        </ul>
    </div>
}
else
{
    <a class="btn login-btn d-flex align-items-center gap-2"
       asp-action="Login"
       asp-controller="Account"
       asp-area="Identity">

        <i class="bi bi-box-arrow-in-right"></i>
        <span>Đăng nhập</span>
    </a>
}
<style>

.account-btn {
    border: none;
    background: transparent;
    color: white;
    padding: 5px 8px;
    border-radius: 12px;
    transition: all 0.2s ease;
}

.account-btn:hover,
.account-btn:focus {
    background: rgba(255, 255, 255, 0.12);
    color: white;
    box-shadow: none;
}

/* Avatar */

.user-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    background: rgba(255, 255, 255, 0.15);
    color: white;

    font-size: 17px;
}

.user-avatar.large {
    width: 44px;
    height: 44px;
    font-size: 20px;
}

/* User information */

.user-info {
    line-height: 1.1;
}

.user-info .user-name {
    display: block;
    max-width: 170px;

    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;

    font-size: 0.85rem;
    font-weight: 600;
}

.user-info small {
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.7rem;
}

/* Dropdown */

.account-menu {
    min-width: 260px;
    padding: 8px;
    border: none;
    border-radius: 14px;
    margin-top: 10px !important;
}

/* Dropdown header */

.account-header {
    display: flex;
    align-items: center;
    gap: 12px;

    padding: 12px;
}

.account-header strong {
    display: block;
    font-size: 0.85rem;

    max-width: 180px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.account-header small {
    display: block;
    color: #6c757d;
    font-size: 0.72rem;
    margin-top: 3px;
}

/* Dropdown item */

.account-menu .dropdown-item {
    padding: 10px 12px;
    border-radius: 9px;

    font-size: 0.85rem;
    transition: all 0.2s ease;
}

.account-menu .dropdown-item:hover {
    background: #f1f3f5;
}

/* Logout */

.account-menu .logout-item {
    color: #dc3545;
}

.account-menu .logout-item:hover {
    background: #fff1f2;
    color: #dc3545;
}

/* Login */

.login-btn {
    border: 1px solid rgba(255, 255, 255, 0.5);
    color: white;

    border-radius: 9px;
    padding: 7px 14px;

    font-size: 0.82rem;
    font-weight: 500;

    transition: all 0.2s ease;
}

.login-btn:hover {
    background: white;
    color: #212529;
    border-color: white;
}
</style>