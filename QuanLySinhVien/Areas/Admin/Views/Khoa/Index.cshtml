@model IEnumerable<QuanLySinhVien.Models.Khoa>

@{
    ViewData["Title"] = "Quản lý khoa";
    var khoaList = Model.ToList();
}

<section class="faculty-page">
    <div class="faculty-hero">
        <div>
            <p class="eyebrow">HỆ THỐNG QUẢN LÝ SINH VIÊN</p>
            <h1>Quản lý khoa</h1>
            <p class="faculty-lead">Sắp xếp và theo dõi thông tin các đơn vị đào tạo trong trường.</p>
        </div>
        <a class="btn btn-light btn-add" asp-action="Upsert">
            <span aria-hidden="true">+</span> Thêm khoa mới
        </a>
    </div>

    <div class="faculty-stats">
        <article class="stat-card">
            <span class="stat-icon icon-indigo">▦</span>
            <div><span>Tổng số khoa</span><strong>@khoaList.Count</strong></div>
        </article>
        <article class="stat-card">
            <span class="stat-icon icon-green">✓</span>
            <div><span>Đang hoạt động</span><strong>@khoaList.Count</strong></div>
        </article>
        <article class="stat-card">
            <span class="stat-icon icon-orange">⌁</span>
            <div><span>Cập nhật gần đây</span><strong>Hôm nay</strong></div>
        </article>
    </div>

    <div class="faculty-panel">
        <div class="panel-toolbar">
            <div>
                <h2>Danh sách khoa</h2>
                <p>@khoaList.Count khoa trong hệ thống</p>
            </div>
            <label class="search-box">
                <span aria-hidden="true">⌕</span>
                <input id="facultySearch" type="search" placeholder="Tìm theo tên khoa..." aria-label="Tìm khoa" />
            </label>
        </div>

        @if (khoaList.Count == 0)
        {
            <div class="empty-state">
                <div>◫</div>
                <h3>Chưa có khoa nào</h3>
                <p>Hãy thêm khoa đầu tiên để bắt đầu quản lý dữ liệu.</p>
                <a class="btn btn-primary" asp-action="Upsert">Thêm khoa mới</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table faculty-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>MÃ KHOA</th>
                            <th>TÊN KHOA</th>
                            <th>MÔ TẢ</th>
                            <th>TRẠNG THÁI</th>
                            <th class="text-end">THAO TÁC</th>
                        </tr>
                    </thead>
                    <tbody id="facultyRows">
                    @foreach (var khoa in khoaList)
                    {
                        <tr>
                            <td><span class="faculty-code">@khoa.MaKhoa.ToString("D2")</span></td>
                            <td><div class="faculty-name"><span>@khoa.TenKhoa[..1].ToUpper()</span>@khoa.TenKhoa</div></td>
                            <td class="faculty-description">@khoa.MoTa</td>
                            <td><span class="status-badge">● Hoạt động</span></td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-action" asp-action="Upsert" asp-route-id="@khoa.MaKhoa">Sửa</a>
                                <button class="btn btn-sm btn-action text-danger" type="button">Xóa</button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <p id="noSearchResult" class="search-empty d-none">Không tìm thấy khoa phù hợp.</p>
        }
    </div>
</section>

@section Scripts {
    <script>
        document.getElementById('facultySearch')?.addEventListener('input', function () {
            const keyword = this.value.trim().toLocaleLowerCase();
            const rows = [...document.querySelectorAll('#facultyRows tr')];
            let visible = 0;
            rows.forEach(row => {
                const matches = row.innerText.toLocaleLowerCase().includes(keyword);
                row.classList.toggle('d-none', !matches);
                if (matches) visible++;
            });
            document.getElementById('noSearchResult')?.classList.toggle('d-none', visible !== 0);
        });
    </script>
}
